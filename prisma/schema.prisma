generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CompetitionKind {
  WORLD_CUP
  EURO
  CHAMPIONS_LEAGUE
  OTHER
}

enum CompetitionStatus {
  DRAFT
  OPEN
  LIVE
  FINISHED
  ARCHIVED
}

enum ExternalDataProvider {
  FOOTBALL_DATA
}

enum MatchStatus {
  SCHEDULED
  LOCKED
  LIVE
  FINISHED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  passwordHash String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competitions      CompetitionPlayer[]
  predictions       Prediction[]
  bonusPredictions CompetitionBonusPrediction[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions PushSubscription[]
}

model Competition {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  kind      CompetitionKind
  status    CompetitionStatus @default(DRAFT)
  bonusEnabled Boolean @default(false)
  bonusLateEntriesEnabled Boolean @default(false)
  bonusWinnerTeamId String?
  bonusSecondTeamId String?
  bonusThirdTeamId String?
  apiFootballLeagueId Int?
  apiFootballSeason   Int?
  apiFootballLastSyncAt DateTime?
  externalProvider ExternalDataProvider?
  externalCompetitionId String?
  externalSeason String?
  emblemUrl String?
  externalLastSyncAt DateTime?
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  players CompetitionPlayer[]
  teams   Team[]
  matches Match[]
  bonusPredictions CompetitionBonusPrediction[]
  bonusWinnerTeam Team? @relation("CompetitionBonusWinner", fields: [bonusWinnerTeamId], references: [id])
  bonusSecondTeam Team? @relation("CompetitionBonusSecond", fields: [bonusSecondTeamId], references: [id])
  bonusThirdTeam Team? @relation("CompetitionBonusThird", fields: [bonusThirdTeamId], references: [id])

  @@index([status])
  @@index([startsAt])
  @@index([apiFootballLeagueId, apiFootballSeason])
  @@index([externalProvider, externalCompetitionId, externalSeason])
}

model CompetitionPlayer {
  id            String   @id @default(cuid())
  userId        String
  competitionId String
  joinedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([userId, competitionId])
  @@index([competitionId])
}

model Team {
  id            String   @id @default(cuid())
  competitionId String
  apiFootballTeamId Int?
  externalTeamId String?
  name          String
  shortName     String?
  code          String?
  flagUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeMatches Match[]     @relation("HomeTeam")
  awayMatches Match[]     @relation("AwayTeam")
  bonusWinnerCompetitions Competition[] @relation("CompetitionBonusWinner")
  bonusSecondCompetitions Competition[] @relation("CompetitionBonusSecond")
  bonusThirdCompetitions Competition[] @relation("CompetitionBonusThird")
  bonusWinnerPredictions CompetitionBonusPrediction[] @relation("CompetitionBonusPredictionWinner")
  bonusSecondPredictions CompetitionBonusPrediction[] @relation("CompetitionBonusPredictionSecond")
  bonusThirdPredictions CompetitionBonusPrediction[] @relation("CompetitionBonusPredictionThird")

  @@unique([competitionId, name])
  @@unique([competitionId, apiFootballTeamId])
  @@unique([competitionId, externalTeamId])
  @@index([competitionId])
}

model Match {
  id            String      @id @default(cuid())
  competitionId String
  apiFootballFixtureId Int?
  externalMatchId String?
  homeTeamId    String?
  awayTeamId    String?
  homePlaceholder String?
  awayPlaceholder String?
  kickoffAt     DateTime
  stage         String
  matchday      Int?
  status        MatchStatus @default(SCHEDULED)
  liveMinute    Int?
  homeScore     Int?
  awayScore     Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeTeam    Team?        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team?        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  predictions Prediction[]

  @@index([competitionId, kickoffAt])
  @@index([status])
  @@unique([competitionId, apiFootballFixtureId])
  @@unique([competitionId, externalMatchId])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId])
}

model CompetitionBonusPrediction {
  id            String   @id @default(cuid())
  userId        String
  competitionId String
  winnerTeamId   String?
  secondTeamId   String?
  thirdTeamId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  winnerTeam  Team?       @relation("CompetitionBonusPredictionWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  secondTeam  Team?       @relation("CompetitionBonusPredictionSecond", fields: [secondTeamId], references: [id], onDelete: SetNull)
  thirdTeam   Team?       @relation("CompetitionBonusPredictionThird", fields: [thirdTeamId], references: [id], onDelete: SetNull)

  @@unique([userId, competitionId])
  @@index([competitionId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
